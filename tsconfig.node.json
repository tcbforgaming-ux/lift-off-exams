{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "eslint.config.js",
    "scripts/pipeline-runtime.d.ts",
    "scripts/verification-target.mjs",
    "vite.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "playwright.ui.config.ts",
    "tests/ui",
    "tests/e2e",
    "src/lib/supabase/database.types.ts"
  ]
}
